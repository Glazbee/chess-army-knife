{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/member-portal",
  "title": "Member Portal",
  "category": "chess-army-knife-membership",
  "icon": "id-alt",
  "description": "Lets members see and correct their own details, choose what they are emailed about, see their membership and event places, and delete their data. No account is needed: members sign in with a link emailed to them.",
  "keywords": [
    "chess",
    "club",
    "member",
    "portal",
    "account",
    "profile",
    "my details"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "templateId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "heading": true,
      "button": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true
    },
    "dimensions": {
      "minHeight": true
    },
    "shadow": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}