{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/team-profiles",
  "title": "Club Teams",
  "category": "chess-army-knife-leagues",
  "icon": "groups",
  "description": "Shows the club's teams: name, description, home venue and, optionally, the leagues they play in, in one or more columns. The squad is shown only if you turn it on.",
  "keywords": [
    "chess",
    "club",
    "team",
    "teams",
    "league",
    "venue"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "templateId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "teamId": {
      "type": "number",
      "default": 0
    },
    "columns": {
      "type": "number",
      "default": 1
    },
    "nameFormat": {
      "type": "string",
      "default": ""
    },
    "groupBy": {
      "type": "string",
      "default": "none"
    },
    "showSeparators": {
      "type": "boolean",
      "default": false
    },
    "groupHeadingLevel": {
      "type": "number",
      "default": 0
    },
    "teamHeadingLevel": {
      "type": "number",
      "default": 0
    },
    "showPlayers": {
      "type": "boolean",
      "default": false
    },
    "playerSort": {
      "type": "string",
      "default": "surname"
    },
    "showRatings": {
      "type": "boolean",
      "default": false
    },
    "ratingColor": {
      "type": "string",
      "default": ""
    },
    "ratingBold": {
      "type": "boolean",
      "default": false
    },
    "ratingItalic": {
      "type": "boolean",
      "default": false
    },
    "ratingSize": {
      "type": "string",
      "default": ""
    },
    "showLeagues": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "heading": true,
      "button": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true
    },
    "dimensions": {
      "minHeight": true
    },
    "shadow": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}