{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/next-club-event",
  "title": "Next Club Event",
  "category": "chess-army-knife-events",
  "icon": "calendar-alt",
  "description": "Shows the next club event, the next three, or today's and tomorrow's, optionally only one with a chosen tag such as in-house.",
  "keywords": [
    "chess",
    "club",
    "event",
    "next",
    "calendar"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "show": {
      "type": "string",
      "enum": [
        "next",
        "three",
        "today"
      ],
      "default": "next"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "showLocation": {
      "type": "boolean",
      "default": true
    },
    "showTags": {
      "type": "boolean",
      "default": true
    },
    "showLinks": {
      "type": "boolean",
      "default": true
    },
    "emptyMessage": {
      "type": "string",
      "default": ""
    },
    "templateId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}