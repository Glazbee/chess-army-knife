{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/tournament-standings",
  "title": "Tournament Standings",
  "category": "widgets",
  "icon": "editor-ol",
  "description": "A cross-table of a tournament: each player's points in every round and their total, in rank order.",
  "keywords": [
    "chess",
    "tournament",
    "standings",
    "table",
    "crosstable"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "tournamentId": {
      "type": "number",
      "default": 0
    },
    "templateId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}