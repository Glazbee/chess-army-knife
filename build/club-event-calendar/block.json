{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/club-event-calendar",
  "title": "Club Event Calendar",
  "category": "chess-army-knife-events",
  "icon": "calendar",
  "description": "Lists upcoming club events by date, optionally only those with chosen tags or teams, home or away, with a calendar feed to subscribe to.",
  "keywords": [
    "chess",
    "club",
    "events",
    "calendar",
    "upcoming"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "layout": {
      "type": "string",
      "default": "agenda"
    },
    "count": {
      "type": "number",
      "default": 10
    },
    "showLocation": {
      "type": "boolean",
      "default": true
    },
    "showTags": {
      "type": "boolean",
      "default": true
    },
    "showLinks": {
      "type": "boolean",
      "default": true
    },
    "showTeams": {
      "type": "boolean",
      "default": true
    },
    "teamIds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "venue": {
      "type": "string",
      "default": "all"
    },
    "showKey": {
      "type": "boolean",
      "default": true
    },
    "showSubscribe": {
      "type": "boolean",
      "default": true
    },
    "emptyMessage": {
      "type": "string",
      "default": ""
    },
    "templateId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "heading": true,
      "button": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true
    },
    "dimensions": {
      "minHeight": true
    },
    "shadow": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}