{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/memberships",
  "title": "Club Memberships",
  "category": "chess-army-knife-membership",
  "icon": "id",
  "description": "Advertises the club's memberships with their prices, and how to pay for them.",
  "keywords": [
    "chess",
    "club",
    "membership",
    "join",
    "price",
    "fees"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showPrice": {
      "type": "boolean",
      "default": true
    },
    "showPaymentInfo": {
      "type": "boolean",
      "default": true
    },
    "joinUrl": {
      "type": "string",
      "default": ""
    },
    "emptyMessage": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}