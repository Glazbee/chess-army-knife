{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chess-army-knife/event-registration",
  "title": "Event Registration",
  "category": "widgets",
  "icon": "tickets-alt",
  "description": "Lets people register for a club event without an account. They confirm from an emailed link and can cancel from their confirmation email. Put it on the event's page, or choose an event.",
  "keywords": [
    "chess",
    "club",
    "event",
    "register",
    "rsvp",
    "sign up"
  ],
  "version": "0.0.1",
  "textdomain": "chess-army-knife",
  "attributes": {
    "eventId": {
      "type": "number",
      "default": 0
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}