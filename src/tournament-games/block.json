{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chess-army-knife/tournament-games",
	"title": "Tournament Games to Play",
	"category": "chess-army-knife-tournaments",
	"icon": "list-view",
	"description": "List the games in a tournament that still have to be played. Administrators can also record the results here.",
	"keywords": [ "chess", "tournament", "fixtures", "games" ],
	"version": "0.0.1",
	"textdomain": "chess-army-knife",
	"attributes": {
		"tournamentId": { "type": "number", "default": 0 },
		"roundsPerPage": { "type": "number", "default": 1 },
		"templateId": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"gradients": true
		},
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true, "fontFamily": true },
		"dimensions": { "minHeight": true },
		"shadow": true,
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
