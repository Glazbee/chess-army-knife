{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chess-army-knife/tournament-status",
	"title": "Tournament Status",
	"category": "chess-army-knife-tournaments",
	"icon": "flag",
	"description": "Show where a tournament stands: whether it has started, the current round, games played and the winner.",
	"keywords": [ "chess", "tournament", "status", "progress" ],
	"version": "0.0.1",
	"textdomain": "chess-army-knife",
	"attributes": {
		"tournamentId": { "type": "number", "default": 0 },
		"templateId": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
