{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chess-army-knife/league-table",
	"title": "ECF League Standings & Matchups",
	"category": "chess-army-knife-leagues",
	"icon": "list-view",
	"description": "Show a league table and recent/upcoming matchups from the ECF League Management System (LMS).",
	"keywords": [
		"chess",
		"ecf",
		"lms",
		"league",
		"standings",
		"fixtures"
	],
	"version": "1.0.0",
	"textdomain": "chess-army-knife",
	"attributes": {
		"orgId": {
			"type": "string",
			"default": ""
		},
		"eventName": {
			"type": "string",
			"default": ""
		},
		"displayMode": {
			"type": "string",
			"default": "both"
		},
		"maxMatches": {
			"type": "number",
			"default": 6
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"highlightTeam": {
			"type": "string",
			"default": ""
		},
		"debug": {
			"type": "boolean",
			"default": false
		},
		"templateId": {
			"type": "string",
			"default": ""
		},
		"season": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
