{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chess-army-knife/rating-chart",
	"title": "ECF Rating Chart",
	"category": "chess-army-knife-ratings",
	"icon": "chart-line",
	"description": "Show how a club member's rating has changed over time, drawn from their recent rated games. Or rotate through members whose rating has risen.",
	"keywords": [
		"chess",
		"ecf",
		"rating",
		"elo"
	],
	"version": "1.0.0",
	"textdomain": "chess-army-knife",
	"attributes": {
		"playerCode": {
			"type": "string",
			"default": ""
		},
		"playerName": {
			"type": "string",
			"default": ""
		},
		"domain": {
			"type": "string",
			"default": ""
		},
		"gamesLimit": {
			"type": "number",
			"default": 100
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 320
		},
		"showStats": {
			"type": "boolean",
			"default": true
		},
		"lineColor": {
			"type": "string",
			"default": ""
		},
		"templateId": {
			"type": "string",
			"default": ""
		},
		"rotation": {
			"type": "string",
			"default": "none"
		},
		"daysBack": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"gradients": true
		},
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true, "fontFamily": true },
		"dimensions": { "minHeight": true },
		"shadow": true,
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
