{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chess-army-knife/club-event-details",
	"title": "Club Event Details",
	"category": "chess-army-knife-events",
	"icon": "location-alt",
	"description": "When and where one club event is, with a map link and an Add to my calendar link. On a page attached to an event it finds the event by itself.",
	"keywords": [ "chess", "club", "event", "details", "when", "where", "location" ],
	"version": "0.0.1",
	"textdomain": "chess-army-knife",
	"attributes": {
		"eventId": { "type": "number", "default": 0 },
		"showLocation": { "type": "boolean", "default": true },
		"showTags": { "type": "boolean", "default": true },
		"showLinks": { "type": "boolean", "default": true },
		"showTeams": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"gradients": true
		},
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true, "fontFamily": true },
		"dimensions": { "minHeight": true },
		"shadow": true,
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
